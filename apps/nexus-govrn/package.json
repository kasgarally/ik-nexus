{
  "name": "nexus-govrn",
  "private": true,
  "scripts": {
    "settings:build": "node ../../scripts/build-settings.mjs",
    "start": "node ../../scripts/build-settings.mjs && meteor run --settings settings.json",
    "build": "meteor build ../output/vue --directory",
    "test": "node tests/run-mocha.mjs",
    "test-app": "node tests/run-mocha.mjs --watch",
    "visualize": "meteor --production --extra-packages bundle-visualizer"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.5",
    "@mdi/font": "^7.4.47",
    "@nexus/applog": "file:../../packages/applog",
    "@nexus/files": "file:../../packages/files",
    "@nexus/lists": "file:../../packages/lists",
    "@nexus/setup": "file:../../packages/setup",
    "@nexus/ui": "file:../../packages/ui",
    "@swc/helpers": "^0.5.17",
    "meteor-node-stubs": "^1.2.30",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-meteor-tracker": "^3.0.0-beta.7",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.1"
  },
  "devDependencies": {
    "@meteorjs/rspack": "^2.2.0",
    "@rsdoctor/rspack-plugin": "^1.5.7",
    "@rspack/cli": "^1.7.1",
    "@rspack/core": "^1.7.1",
    "@types/meteor": "^2.9.7",
    "cross-env": "^10.1.0",
    "vue-loader": "^17.4.2"
  },
  "meteor": {
    "modern": true,
    "mainModule": {
