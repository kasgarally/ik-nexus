# Non-secret defaults for the local Penpot design stack

PENPOT_VERSION=2.17.2
PENPOT_PORT=9001
PENPOT_MAILCATCH_PORT=1080
PENPOT_PUBLIC_URI=http://localhost:9001
PENPOT_HTTP_SERVER_MAX_BODY_SIZE=367001600

# `pnpm penpot:init` replaces these placeholders in the gitignored .env.
PENPOT_SECRET_KEY=generate-with-pnpm-penpot-init
PENPOT_DATABASE_PASSWORD=generate-with-pnpm-penpot-init
