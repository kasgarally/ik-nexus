# Author: Karmil Asgarally - INTELLEKTRA © 2026
# Manual-deploy runtime env — copy to a 0600 file outside git
#
# On the droplet: /home/nexus/etc/<APP_NAME>.env
# Example APP_NAME: nexus-govrn
# Do not put secrets in this committed example.
# Do not put secrets in Meteor.settings.public.

ROOT_URL=https://app.example.com
PORT=3000

# App user on the local replica. URL-encode @ : / # ? in the password.
# Atlas: replace this whole URL and skip the local mongod.
# Database name is usually APP_NAME (example: nexus-govrn).
MONGO_URL=mongodb://nexus_app:CHANGE_ME@127.0.0.1:27017/APP_NAME?replicaSet=rs0&authSource=APP_NAME

# Compact JSON from apps/<APP_NAME>/settings.jsonc (devSeedAdmin must be false).
# Prefer: node scripts/build-settings.mjs then JSON.stringify the result.
METEOR_SETTINGS={"public":{"devSeedAdmin":false}}

# Optional until the Meteor app sends mail / SMS
MAIL_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
