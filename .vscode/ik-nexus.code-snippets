// Workspace snippets for file headers and README Contents
{
  "File header JS": {
    "scope": "javascript,typescript",
    "prefix": "header",
    "body": [
      "/**",
      " * Author: Karmil Asgarally - INTELLEKTRA © 2026",
      " * ${1:Description}",
      " */",
      "$0"
    ],
    "description": "INTELLEKTRA file header (JS/TS)"
  },
  "File header markup": {
    "scope": "html,vue,markdown,mdc",
    "prefix": "header",
    "body": [
      "<!--",
      "Author: Karmil Asgarally - INTELLEKTRA © 2026",
      "${1:Description}",
      "-->",
      "$0"
    ],
    "description": "INTELLEKTRA file header (HTML/Vue/Markdown)"
  },
  "File header hash": {
    "scope": "dockerfile,shellscript,yaml,ignore",
    "prefix": "header",
    "body": [
      "# Author: Karmil Asgarally - INTELLEKTRA © 2026",
      "# ${1:Description}",
      "$0"
    ],
    "description": "INTELLEKTRA file header (# comments)"
  },
  "README Contents": {
    "scope": "markdown",
    "prefix": "contents",
    "body": [
      "## Contents",
      "",
      "- [${1:Section}](#${2:section})",
      "$0"
    ],
    "description": "README Contents section"
  },
  "NEXUS collection file": {
    "scope": "javascript",
    "prefix": "nexus-collection",
    "body": [
      "/**",
      " * Author: Karmil Asgarally - INTELLEKTRA © 2026",
      " * ${1:name} collection: schema, deny, methods, publications",
      " *",
      " * 1. Constants",
      " * 2. Collection",
      " * 3. Schema",
      " * 4. Deny client writes",
      " * 5. Server methods and publications",
      " * 6. Indexes",
      " */",
      "import { check } from 'meteor/check'",
      "import { Meteor } from 'meteor/meteor'",
      "import { Mongo } from 'meteor/mongo'",
      "import { denyClientWrites, requireLoggedIn, requireRole, SimpleSchema, validateDocument } from '/imports/api/methodHelpers.js'",
      "",
      "const collectionName = '${1:name}'",
      "const rolePrefix = collectionName",
      "",
      "export const ${1/(.*)/${1:/capitalize}/} = new Mongo.Collection(collectionName)",
      "",
      "export const ${1}Schema = new SimpleSchema({",
      "  ${2:title: { type: String, min: 1, label: 'Title' },}",
      "})",
      "",
      "denyClientWrites(${1/(.*)/${1:/capitalize}/})",
      "",
      "if (Meteor.isServer) {",
      "  Meteor.methods({",
      "    async [`\\${collectionName}.insert`](params) {",
      "      check(params, Object)",
      "      const userId = requireLoggedIn(this.userId)",
      "      await requireRole(userId, `\\${rolePrefix}.create`)",
      "      const doc = await validateDocument(${1}Schema, params)",
      "      const now = new Date()",
      "      return ${1/(.*)/${1:/capitalize}/}.insertAsync({ ...doc, createdAt: now, updatedAt: now, createdBy: userId })",
      "    },",
      "",
      "    async [`\\${collectionName}.update`](params) {",
      "      check(params, Object)",
      "      check(params.id, String)",
      "      const userId = requireLoggedIn(this.userId)",
      "      await requireRole(userId, `\\${rolePrefix}.update`)",
      "      const existing = await ${1/(.*)/${1:/capitalize}/}.findOneAsync(params.id)",
      "      if (!existing) {",
      "        throw new Meteor.Error('not-found', 'No document for that id')",
      "      }",
      "      const { id, ...fields } = params",
      "      const doc = await validateDocument(${1}Schema, fields)",
      "      await ${1/(.*)/${1:/capitalize}/}.updateAsync(id, { \\$set: { ...doc, updatedAt: new Date() } })",
      "      return id",
      "    },",
      "",
      "    async [`\\${collectionName}.remove`](params) {",
      "      check(params, { id: String })",
      "      const userId = requireLoggedIn(this.userId)",
      "      await requireRole(userId, `\\${rolePrefix}.remove`)",
      "      const existing = await ${1/(.*)/${1:/capitalize}/}.findOneAsync(params.id)",
      "      if (!existing) {",
      "        throw new Meteor.Error('not-found', 'No document for that id')",
      "      }",
      "      await ${1/(.*)/${1:/capitalize}/}.removeAsync(params.id)",
      "      return params.id",
      "    },",
      "  })",
      "",
      "  Meteor.publish(`\\${collectionName}.list`, function publishList() {",
      "    if (!this.userId) {",
      "      return this.ready()",
      "    }",
      "    return ${1/(.*)/${1:/capitalize}/}.find({}, { sort: { createdAt: -1 } })",
      "  })",
      "",
      "  Meteor.publish(`\\${collectionName}.one`, function publishOne(id) {",
      "    check(id, String)",
      "    if (!this.userId) {",
      "      return this.ready()",
      "    }",
      "    return ${1/(.*)/${1:/capitalize}/}.find({ _id: id })",
      "  })",
      "",
      "  Meteor.startup(() => {",
      "    void ${1/(.*)/${1:/capitalize}/}.createIndexAsync({ createdAt: -1 })",
      "  })",
      "}",
      "$0"
    ],
    "description": "One NEXUS collection file (constants, SimpleSchema, methods, pubs)"
  }
}
