# Author: Karmil Asgarally - INTELLEKTRA © 2026
# Gitignored runtime overlay — copy to <app>.local.env (this file is the nexus-govrn example)
#
# `npm run docker:up -- <app>` writes METEOR_SETTINGS from apps/<app>/settings.jsonc.
# Do not put secrets in the committed .env or in Meteor.settings.public.

# Hosted Mongo (Atlas or similar). Leave unset (or commented) to run in-stack mongo:7.
# Do not leave MONGO_URL= empty — comment the line or omit it.
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/nexus-govrn

# Optional override of the committed bind-mount path (docker/apps/nexus-govrn.env).
# Droplet Block Storage example: /mnt/mongo/nexus-govrn
# MONGO_DATA_DIR=

# SMTP for Meteor email (SendGrid, SES, …)
MAIL_URL=

# Twilio SMS — unused until the app reads these
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
