# nexus-govrn stack settings (ports, ROOT_URL, Mongo path).
# METEOR_SETTINGS is not here. docker:up writes it to the gitignored
# nexus-govrn.local.env overlay (one long last line).
APP_NAME=nexus-govrn
HTTP_PORT=8081
HTTPS_PORT=8443
ROOT_URL=https://localhost:8443
MONGO_DB=nexus-govrn
MONGO_DATA_DIR=./data/nexus-govrn/mongo
